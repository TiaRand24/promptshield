{
  "name": "prompt-shield",
  "version": "1.0.0",
  "description": "Production-grade, 100% client-side Manifest V3 Chrome Extension that sanitizes PII and secrets in AI prompts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.content.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.11.0",
    "jsdom": "^22.1.0",
    "typescript": "^5.3.3",
    "vite": "^4.5.3",
    "vitest": "^0.34.6"
  }
}
